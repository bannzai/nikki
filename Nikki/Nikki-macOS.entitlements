<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CloudKit のサイレントプッシュ(サーバ変更通知)を受けるための APNs 環境。macOS は iOS の aps-environment と異なり com.apple.developer. 前置のキーを使う。配布時は Xcode が production に差し替える -->
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
	<!-- 接続する CloudKit 環境。未指定の開発署名ビルドは開発環境に繋がり、TestFlight/App Store の iOS 版
	     (本番環境) とデータが同期されない(issue #92)。make macos の Release ビルドを普段使いする運用のため、
	     本番環境を明示する。開発署名でも本値は Production を指定できる。
	     macOS の Debug ビルドは CloudKit 同期なしの開発用ストアを使うため本値の影響を受けない。
	     aps-environment は開発署名では development しか許可されず、本番環境のサーバ変更通知(サイレントプッシュ)は
	     届かないが、SwiftData はアプリのライフサイクル契機でも同期するため実用上は追従できる -->
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.bannzai.Nikki</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Mac App Store 配布の必須要件 -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.bannzai.Nikki</string>
	</array>
	<!-- App Sandbox 下で CloudKit / RevenueCat が外部へ通信するために必要 -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
