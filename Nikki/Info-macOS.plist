<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- AppKit は iOS の UIAppFonts に相当する自動登録を持たないため、Resources 直下(フラットにコピーされる)のフォントをこのキーで登録する -->
	<key>ATSApplicationFontsPath</key>
	<string>.</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Nikki</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- 独自の暗号実装を持たず、HTTPS と iCloud(CloudKit) の OS 標準暗号化のみを使うため輸出コンプライアンスの免除区分に該当する。提出ごとの申告質問を省くためここで宣言する -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<!-- Ink デザインは光の紙面(ライト外観)前提。iOS 側の UIUserInterfaceStyle = Light に合わせて macOS でもライト外観に固定する -->
	<key>NSRequiresAquaSystemAppearance</key>
	<true/>
</dict>
</plist>
