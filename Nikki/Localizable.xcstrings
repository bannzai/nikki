    "Rain all day. I forgot my umbrella and stood at the station, but fifteen minutes of shelter wasn't bad at all.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一日じゅう雨。傘を忘れて駅で立ち尽くしたけれど、雨宿りの15分は悪くなかった。"
          }
        }
      }
    },
