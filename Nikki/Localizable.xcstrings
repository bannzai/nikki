          }
        }
      }
    },
    "Sunny, then a shower": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "晴れのち夕立"
          }
        }
      }
    },
    "Switched the closet to summer. Last year's shirts still smelled like last summer.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クローゼットを夏仕様に。去年の夏のシャツから、去年の夏のにおいがした。"
          }
        }
      }
    },
    "Template": {
